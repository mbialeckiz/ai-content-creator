# Skopiuj ten plik do .env i uzupełnij. Nigdy nie commituj .env.

# Wymagany. Silnik SDK uruchamia CLI Claude Code jako podproces, który czyta
# ten klucz ze środowiska procesu nadrzędnego (patrz SPEC sekcja 5).
ANTHROPIC_API_KEY=

# Katalog roboczy agenta (skille, baza wiedzy, korpus, plan, output).
# Docelowo ścieżka do folderu zsynchronizowanego z Google Drive.
KATALOG_DANYCH=./dane

# Opcjonalny. Nie przypinamy modelu w kodzie (CLAUDE.md) — jeśli puste,
# używany jest domyślny model CLI Claude Code.
MODEL=

# Sufit kosztu JEDNEJ operacji w dolarach. Zabezpieczenie przed
# niespodziewanym rachunkiem: po przekroczeniu asystent przerywa pracę
# i mówi o tym wprost. Puste = wartości domyślne z kodu (0,60 USD na post,
# 1,50 USD na plan miesiąca). Podnoś ostrożnie.
LIMIT_USD_NA_OPERACJE=

# Port lokalnego serwera (domyślnie 8420, patrz SPEC sekcja 4).
PORT=8420
