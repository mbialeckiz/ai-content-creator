.env
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.DS_Store

# Katalogi wyjściowe agenta — plany i wygenerowane posty powstają przy
# każdym uruchomieniu i są własnością operatorki (wersjonuje je Dysk
# Google), nie repozytorium. Same katalogi zostają, zawartość nie.
dane/plan/*
dane/output/*
!dane/plan/.gitkeep
!dane/output/.gitkeep

# Korpus i materiały z firmy dostarcza administrator osobną paczką
# (CLAUDE.md) — w repozytorium zostaje samo rusztowanie.
dane/korpus/linkedin/*
dane/input-firmowy/*
!dane/korpus/linkedin/.gitkeep
!dane/input-firmowy/.gitkeep

# Dokumenty wgrane przez operatorkę i wyciągi z nich. To materiały klienta —
# raporty branżowe, notatki — i nie mają czego szukać w repozytorium kodu.
dane/artykuly/*
!dane/artykuly/.gitkeep
